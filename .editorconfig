root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# IntelliJ の既定の書き方に寄せる
ktlint_code_style = intellij_idea
max_line_length = 120
# Compose の @Composable 関数は大文字で始める
ktlint_function_naming_ignore_when_annotated_with = Composable
